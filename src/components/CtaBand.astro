---
import { site, cta } from "../data/site";
---

<section class="mx-auto max-w-6xl px-5 pb-24">
  <div class="rounded-xxl bg-gradient-violet p-8 md:p-12">
    <p class="text-xs font-semibold uppercase tracking-widest text-white/70">Packages</p>
    <h2 class="display-md mt-3 max-w-2xl">Two ways to start. Fixed quote before we begin.</h2>
    <div class="mt-8 grid gap-4 md:grid-cols-2">
      <div class="rounded-xl bg-black/25 p-6">
        <h3 class="font-semibold tracking-tight text-white">Paid 2-hour trial</h3>
        <p class="mt-2 text-sm leading-relaxed text-white/85">Small paid test — one chart, one slide, or one brief. Proves fit before a project.</p>
        <p class="mt-3 text-xs font-medium uppercase tracking-widest text-white/70">48-hour turnaround</p>
      </div>
      <div class="rounded-xl bg-black/25 p-6">
        <h3 class="font-semibold tracking-tight text-white">Fixed-scope project</h3>
        <p class="mt-2 text-sm leading-relaxed text-white/85">Decks in 48–72h, standard cases in 5–7 days. Plan, deadline, and quote in writing.</p>
        <p class="mt-3 text-xs font-medium uppercase tracking-widest text-white/70">Add-ons: pitch deck, dashboard, SEO brief, captions</p>
      </div>
    </div>
    <p class="mt-6 max-w-xl text-[15px] text-white/90">
      Analyst internships, research assistance, decks, SEO, and video. Replies within 24 hours.
    </p>
    <div class="mt-6 flex flex-wrap gap-3">
      <a href="/contact" class="rounded-full bg-white px-5 py-2.5 text-sm font-medium text-black">
        {cta.startBrief}
      </a>
      <a href={site.calLink} target="_blank" rel="noopener" class="rounded-full bg-black/25 px-5 py-2.5 text-sm font-medium text-white">
        Book intro call
      </a>
      <a href="/cv-omar-ali.pdf" class="rounded-full bg-black/25 px-5 py-2.5 text-sm font-medium text-white">
        Download CV
      </a>
    </div>
  </div>
</section>
