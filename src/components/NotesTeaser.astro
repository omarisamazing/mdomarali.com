---
import { notes } from "../data/notes";
---

<section class="mx-auto max-w-6xl px-5 pb-24">
  <p class="text-xs font-semibold uppercase tracking-widest text-ink-muted">Notes and resources</p>
  <h2 class="display-lg mt-3 max-w-3xl">Steal my checklists.</h2>
  <p class="mt-4 max-w-2xl text-lg text-ink-muted">
    Free on request. No email gate, no pitch. The same documents I use on real engagements.
  </p>
  <div class="mt-10 grid gap-4 md:grid-cols-3">
    {
      notes.map((p) => (
        <a href="/about#notes" class="block rounded-xl border border-hairline-soft bg-surface-1 p-6 transition hover:bg-surface-2">
          <span class="rounded-full bg-surface-2 px-3 py-1 text-xs font-medium text-ink">{p.tag}</span>
          <span class="mt-3 block text-lg font-semibold tracking-tight">{p.title}</span>
          <span class="mt-1 block text-sm text-ink-muted">{p.meta}</span>
        </a>
      ))
    }
  </div>
</section>
