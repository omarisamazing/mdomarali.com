---
import { Image } from "astro:assets";
import iconWhite from "../assets/Logos/omarali-logo-icon-white.svg";
import iconBlack from "../assets/Logos/omarali-logo-icon-black.svg";
import wordmarkBrand from "../assets/Logos/omarali-wordmark-brand.svg";
import Icon from "./Icon.astro";
import { site } from "../data/site";

const CAL_LINK = site.calLink;
---

<footer class="border-t border-hairline-soft">
  <div class="mx-auto grid max-w-6xl gap-10 px-5 py-14 md:grid-cols-[1.2fr_1fr_1fr]">
    <div>
      <h2 class="display-md max-w-xs">Got a project in mind?</h2>
      <a
        href={CAL_LINK}
        target="_blank"
        rel="noopener"
        class="mt-6 inline-flex items-center gap-1.5 rounded-full bg-ink px-5 py-2.5 text-sm font-medium text-canvas transition hover:opacity-90"
      >
        Schedule a call
        <Icon name="arrow" class="h-4 w-4" />
      </a>
    </div>
    <nav class="text-[13px]" aria-label="Explore">
      <p class="text-base font-medium text-ink-muted">Explore</p>
      <ul class="mt-3 space-y-2.5 text-ink">
        <li><a href="/" class="hover:text-ink-muted">Home</a></li>
        <li><a href="/about" class="hover:text-ink-muted">About me</a></li>
        <li><a href="/work" class="hover:text-ink-muted">Work</a></li>
        <li><a href="/contact" class="hover:text-ink-muted">Contact</a></li>
        <li><a href={CAL_LINK} target="_blank" rel="noopener" class="hover:text-ink-muted">Book a call</a></li>
      </ul>
    </nav>
    <nav class="text-[13px]" aria-label="Resources">
      <p class="text-base font-medium text-ink-muted">Resources</p>
      <ul class="mt-3 space-y-2.5 text-ink">
        <li><a href="/about#notes" class="hover:text-ink-muted">Notes</a></li>
        <li><a href="/work" class="hover:text-ink-muted">Videos</a></li>
        <li><a href="/cv-omar-ali.pdf" class="hover:text-ink-muted">CV (PDF)</a></li>
        <li><a href="/contact" class="hover:text-ink-muted">Start a brief</a></li>
      </ul>
    </nav>
  </div>
  <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-2 px-5 pb-8 text-xs text-ink-muted">
    <Image src={iconWhite} alt="" height={18} class="hidden dark:block" />
    <Image src={iconBlack} alt="" height={18} class="dark:hidden" />
    <p>© 2026 Md. Omar Ali. Dhaka, remote worldwide. Decks, dashboards, SEO, and video.</p>
  </div>
  {/* Giant decorative wordmark: the only full wordmark on the site */}
  <div aria-hidden="true" class="select-none overflow-hidden px-5">
    {/* Plain img: Astro Image does not process SVGs, widths/srcset break them */}
    <img
      src={wordmarkBrand.src}
      alt=""
      class="pointer-events-none mx-auto w-full max-w-6xl translate-y-[18%]"
    />
  </div>
</footer>
