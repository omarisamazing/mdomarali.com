---
import { Image } from "astro:assets";
import iconWhite from "../assets/Logos/omarali-logo-icon-white.svg";
import iconBlack from "../assets/Logos/omarali-logo-icon-black.svg";
import ThemeToggle from "./ThemeToggle.astro";
import Icon from "./Icon.astro";
import { navLinks as links } from "../data/site";
---

<header class="sticky top-3 z-50 px-5">
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-3 rounded-full border border-hairline-soft bg-canvas/85 py-2 pl-4 pr-2 backdrop-blur">
    <a href="/" aria-label="Md. Omar Ali, home" class="shrink-0">
      <Image src={iconWhite} alt="" height={28} class="hidden dark:block" />
      <Image src={iconBlack} alt="" height={28} class="dark:hidden" />
    </a>
    <div class="hidden items-center gap-1 rounded-full bg-surface-1 p-1 md:flex">
      {
        links.map((l) => (
          <a href={l.href} class="rounded-full px-4 py-1.5 text-sm font-medium text-ink-muted transition hover:bg-surface-2 hover:text-ink">
            {l.label}
          </a>
        ))
      }
    </div>
    <div class="flex items-center gap-2">
      <ThemeToggle />
      <a
        href="/contact"
        class="hidden items-center gap-1.5 rounded-full bg-ink px-4 py-2 text-sm font-medium text-canvas transition hover:opacity-90 sm:inline-flex"
      >
        Hire me
        <Icon name="arrow" class="h-4 w-4" />
      </a>
      <details class="relative md:hidden">
        <summary class="cursor-pointer list-none rounded-full bg-surface-1 px-4 py-2 text-sm font-medium text-ink [&::-webkit-details-marker]:hidden">
          Menu
        </summary>
        <div class="absolute right-0 top-12 w-44 rounded-xl border border-hairline-soft bg-canvas p-2 shadow-xl">
          {
            links.map((l) => (
              <a href={l.href} class="block rounded-lg px-3 py-2.5 text-sm font-medium text-ink hover:bg-surface-1">
                {l.label}
              </a>
            ))
          }
          <a href="/contact" class="block rounded-lg bg-ink px-3 py-2.5 text-sm font-medium text-canvas">
            Hire me
          </a>
        </div>
      </details>
    </div>
  </nav>
</header>
