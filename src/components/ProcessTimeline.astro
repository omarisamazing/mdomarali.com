---
// "How things will go" timeline. Conceptzilla-style scroll animation:
// alternating zigzag cards around a center rail (left rail on mobile),
// rail fills as steps activate, nodes pop, ambient glows drift.
// Vanilla IntersectionObserver + CSS only. No-JS and
// prefers-reduced-motion both fall back to fully visible static content.
interface Props {
  secondary?: "work" | "about";
}

const { secondary = "work" } = Astro.props;
const steps = [
  { n: "01", t: "Brief in 15 min", d: "Goal, audience, deadline, files. You get a fixed quote back." },
  { n: "02", t: "Method plus draft", d: "Outline or early analysis first. You approve the direction before polish." },
  { n: "03", t: "Polish and QA", d: "Charts checked, copy tightened, master slides built." },
  { n: "04", t: "Handover plus Loom", d: "Source files, a short walkthrough video, and next steps." },
];
---

<section id="process" class="relative mx-auto max-w-6xl scroll-mt-24 overflow-hidden px-5 py-24" data-timeline>
  <div aria-hidden="true" class="pointer-events-none absolute inset-0">
    <span class="timeline-glow timeline-glow-a"></span>
    <span class="timeline-glow timeline-glow-b"></span>
  </div>

  <p class="relative text-xs font-semibold uppercase tracking-widest text-ink-muted">Process</p>
  <h2 class="display-lg relative mt-3 max-w-3xl">How things will go. Short and sweet.</h2>

  <div class="relative mt-12">
    <div aria-hidden="true" class="timeline-lines">
      <span class="timeline-track"></span>
      <span class="timeline-fill" data-timeline-fill></span>
    </div>
  <ol>
    {
      steps.map((s, i) => (
        <li
          data-timeline-step
          data-side={i % 2 === 0 ? "left" : "right"}
          class:list={[
            "relative pb-12 pl-10 last:pb-0 md:w-1/2 md:pb-16 md:pl-0",
            i % 2 === 0 ? "md:mr-auto md:pr-14" : "md:ml-auto md:pl-14",
          ]}
        >
          <span
            aria-hidden="true"
            class:list={[
              "timeline-node absolute left-0 top-6 h-4 w-4 rounded-full border-2 border-accent bg-canvas",
              i % 2 === 0 ? "md:left-auto md:-right-2" : "md:-left-2",
            ]}
          />
          <div class="rounded-xl border border-hairline-soft bg-surface-1 p-6">
            <p class="text-sm font-bold text-ink-muted">{s.n}</p>
            <h3 class="mt-1 font-semibold tracking-tight">{s.t}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-muted">{s.d}</p>
          </div>
        </li>
      ))
    }
  </ol>
  </div>

  <div class="relative mt-10 flex flex-wrap gap-3">
    <a href="/contact" class="rounded-full bg-ink px-5 py-2.5 text-sm font-medium text-canvas transition hover:opacity-90">
      Start with a brief
    </a>
    {secondary === "work" ? (
      <a href="/work" class="rounded-full bg-surface-1 px-5 py-2.5 text-sm font-medium text-ink transition hover:bg-surface-2">
        See the proof
      </a>
    ) : (
      <a href="/about" class="rounded-full bg-surface-1 px-5 py-2.5 text-sm font-medium text-ink transition hover:bg-surface-2">
        About Omar
      </a>
    )}
  </div>
</section>

<script>
  (() => {
    const sections = document.querySelectorAll("[data-timeline]");
    if (!sections.length) return;
    sections.forEach((section) => {
      const steps = Array.from(section.querySelectorAll("[data-timeline-step]"));
      const fill = section.querySelector("[data-timeline-fill]");
      section.classList.add("timeline-js");
      if (
        window.matchMedia("(prefers-reduced-motion: reduce)").matches ||
        !("IntersectionObserver" in window)
      ) {
        steps.forEach((s) => s.classList.add("is-visible"));
        if (fill) fill.style.height = "100%";
        return;
      }
      let visible = 0;
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add("is-visible");
            io.unobserve(entry.target);
            visible += 1;
            if (fill) fill.style.height = `${(visible / steps.length) * 100}%`;
          });
        },
        { threshold: 0.4, rootMargin: "0px 0px -8% 0px" }
      );
      steps.forEach((s) => io.observe(s));
    });
  })();
</script>

<style>
  .timeline-lines {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 8px;
    width: 2px;
    margin-left: -1px;
    mask-image: linear-gradient(to bottom, transparent, black 6%, black 94%, transparent);
    -webkit-mask-image: linear-gradient(to bottom, transparent, black 6%, black 94%, transparent);
  }
  @media (min-width: 768px) {
    .timeline-lines {
      left: 50%;
    }
  }
  .timeline-track {
    position: absolute;
    inset: 0;
    background: var(--color-hairline);
  }
  .timeline-fill {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 0;
    background: var(--color-accent);
    transition: height 0.7s ease;
  }
  .timeline-node {
    transition:
      transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1),
      background-color 0.3s ease;
  }
  .timeline-glow {
    position: absolute;
    border-radius: 9999px;
    filter: blur(90px);
    pointer-events: none;
  }
  .timeline-glow-a {
    width: 420px;
    height: 420px;
    top: -120px;
    left: -140px;
    background: #1868db;
    opacity: 0.16;
    animation: timeline-drift-a 46s ease-in-out infinite;
  }
  .timeline-glow-b {
    width: 380px;
    height: 380px;
    bottom: -140px;
    right: -120px;
    background: #418bd6;
    opacity: 0.12;
    animation: timeline-drift-b 52s ease-in-out infinite;
  }
  @keyframes timeline-drift-a {
    0%,
    100% {
      transform: translate(0, 0) scale(1);
    }
    50% {
      transform: translate(90px, 70px) scale(1.1);
    }
  }
  @keyframes timeline-drift-b {
    0%,
    100% {
      transform: translate(0, 0) scale(1);
    }
    50% {
      transform: translate(-80px, -60px) scale(1.08);
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .timeline-js [data-timeline-step] {
      opacity: 0;
      transform: translateX(24px);
      transition:
        opacity 0.6s ease,
        transform 0.6s cubic-bezier(0.22, 0.61, 0.36, 1);
    }
    .timeline-js [data-timeline-step].is-visible {
      opacity: 1;
      transform: none;
    }
    .timeline-js .timeline-node {
      transform: scale(0);
    }
    .timeline-js .is-visible .timeline-node {
      transform: scale(1);
    }
  }
  @media (prefers-reduced-motion: no-preference) and (min-width: 768px) {
    .timeline-js [data-side="left"] {
      transform: translateX(-32px);
    }
    .timeline-js [data-side="right"] {
      transform: translateX(32px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .timeline-glow {
      animation: none;
    }
  }
</style>
