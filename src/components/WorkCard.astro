---
import type { WorkCard as Card } from "../data/cases";
import { craftCtaLabel } from "../data/site";

interface Props {
  card: Card;
  index?: number;
  eager?: boolean;
}

const { card: c, index = 0, eager = false } = Astro.props;
const link = c.slug ? `/work/${c.slug}` : "/contact";
const linkLabel = c.slug ? craftCtaLabel(c.eyebrow) : "Ask for full case file";
---

<article
  data-category={c.category}
  class="work-card flex h-full flex-col overflow-hidden rounded-xl border border-hairline-soft bg-surface-1 transition-transform duration-200 ease-out motion-reduce:transform-none hover:-translate-y-1"
>
  <a href={link} class="relative block overflow-hidden" aria-label={c.title}>
    {c.hasVideo && c.galleryCount === 0 ? (
      <video
        src={c.coverVideo}
        preload="metadata"
        muted
        loop
        playsinline
        disablepictureinpicture
        data-hover-play
        class="aspect-[16/10] w-full object-cover"
        aria-hidden="true"
      />
    ) : (
      <img
        src={c.cover}
        alt={c.coverAlt}
        loading={eager ? "eager" : "lazy"}
        decoding="async"
        fetchpriority={eager ? "high" : undefined}
        class="aspect-[16/10] w-full object-cover object-top transition duration-200 ease-out hover:scale-[1.02]"
      />
    )}
    {(c.galleryCount > 1 || c.hasVideo) && (
      <span class="absolute bottom-3 right-3 flex items-center gap-1.5">
        {c.galleryCount > 1 && (
          <span class="rounded-full bg-ink px-2.5 py-1 text-[11px] font-semibold text-canvas shadow-lg ring-1 ring-black/15">
            {c.galleryCount} shots
          </span>
        )}
        {c.hasVideo && (
          <span class="rounded-full bg-ink px-2.5 py-1 text-[11px] font-semibold text-canvas shadow-lg ring-1 ring-black/15">
            Video
          </span>
        )}
      </span>
    )}
  </a>
  <div class="flex flex-1 flex-col p-6">
  <p class="flex items-center justify-between gap-2 text-xs font-semibold uppercase tracking-widest text-ink-muted">
    <span class="flex items-center gap-2">
      {c.eyebrow}
      {c.spotlight && <span class="rounded-full bg-accent px-2.5 py-0.5 text-[10px] font-bold normal-case tracking-normal text-white">Featured</span>}
    </span>
    <span aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
  </p>
  <h3 class="mt-3 text-xl font-semibold tracking-tight">{c.title}</h3>
  <p class="mt-1 text-[15px] font-semibold text-ink">{c.outcome}</p>
  <p class="mt-2 line-clamp-2 text-sm text-ink-muted">{c.brief}</p>
  <div class="mt-4 flex flex-wrap gap-2">
    {c.stack.slice(0, 2).map((t) => (
      <span class="rounded-full bg-surface-2 px-3 py-1 text-xs font-medium text-ink">
        {t}
      </span>
    ))}
  </div>
  <a href={link} class="mt-auto inline-block pt-5 text-sm font-medium text-accent">
    {linkLabel}
  </a>
  </div>
</article>
