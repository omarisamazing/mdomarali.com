---
import { Image } from "astro:assets";
import cutout from "../assets/transparent-omarali-headshot.webp";
import Icon from "./Icon.astro";
import { site, proofStats as stats } from "../data/site";

// About teaser: "who am I" chip, person-first copy, portrait card with a
// glass proof overlay. Destinations are all functional: email, WhatsApp, Cal.
const EMAIL = site.email;
const WHATSAPP = site.whatsapp;

// Split "15+" -> { target: 15, suffix: "+" } so the count-up script can
// animate the number while keeping the suffix static.
const parseStat = (value: string) => {
  const m = value.match(/^(\d+)(.*)$/);
  return { target: m ? Number(m[1]) : 0, suffix: m ? m[2] : "" };
};
---

<section class="mx-auto max-w-6xl px-5 py-24">
  <div class="grid items-start gap-10 lg:grid-cols-2 lg:gap-14">
    <div>
      <p class="inline-flex items-center gap-1.5 rounded-full bg-surface-1 px-3.5 py-1.5 text-xs font-semibold text-ink">
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-accent"></span>
        Who am I?
      </p>
      <h2 class="display-lg mt-4">Meet Md. Omar Ali, analyst in training, designer by craft.</h2>
      <p class="mt-5 leading-relaxed text-ink-muted">
        Third-year Economics student from Bangladesh, building an analyst profile the
        verifiable way: public data, documented method, and artifacts a team can reuse.
        Alongside coursework I ship presentation design, SEO content, and video work.
      </p>
      <p class="mt-4 leading-relaxed text-ink-muted">
        Currently preparing for IELTS and learning Deutsch (A2 to B1), because the roles
        I am targeting are remote-first and international.
      </p>
      <div class="mt-6 flex flex-wrap gap-2">
        <a
          href={`mailto:${EMAIL}`}
          class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-surface-1 text-ink transition hover:bg-surface-2"
          aria-label="Email Omar"
        >
          <Icon name="mail" />
        </a>
        <a
          href={WHATSAPP}
          target="_blank"
          rel="noopener"
          class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-surface-1 text-ink transition hover:bg-surface-2"
          aria-label="WhatsApp Omar"
        >
          <Icon name="chat" />
        </a>
        <a
          href="/book"
          class="inline-flex h-10 items-center gap-2 rounded-full bg-ink px-5 text-sm font-medium text-canvas transition hover:opacity-90"
        >
          <Icon name="calendar" class="h-4 w-4" />
          Book a call
        </a>
      </div>
    </div>

    <div class="relative mx-auto w-full max-w-sm">
      <div aria-hidden="true" class="pointer-events-none absolute -inset-8">
        <span class="absolute left-1/2 top-8 h-72 w-72 -translate-x-1/2 rounded-full bg-gradient-violet opacity-20 blur-[100px] dark:opacity-30"></span>
        <span class="absolute bottom-0 right-4 h-56 w-56 rounded-full bg-gradient-magenta opacity-10 blur-[100px] dark:opacity-20"></span>
      </div>
      {/* Framed crop: the cutout asset has leftover background chunks at its
          edges, so scale past them inside an overflow-hidden frame. */}
      <div class="relative aspect-[4/5] overflow-hidden rounded-xxl border border-hairline-soft bg-surface-1">
        <Image
          src={cutout}
          alt="Md. Omar Ali in a black suit"
          widths={[480, 800]}
          sizes="(max-width: 1024px) 100vw, 400px"
          quality="high"
          class="absolute inset-0 h-full w-full scale-[1.05] object-cover object-[50%_12%] drop-shadow-[0_24px_50px_rgba(24,104,219,0.18)] [mask-image:linear-gradient(to_bottom,black_90%,transparent_99%)] dark:drop-shadow-[0_36px_60px_rgba(24,104,219,0.32)]"
        />
        <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-canvas via-canvas/60 to-transparent"></div>
      </div>
      <dl class="relative mt-2 grid grid-cols-3 gap-2 border-t border-hairline-soft pt-5">
        {
          stats.map((s) => {
            const { target, suffix } = parseStat(s.value);
            return (
              <div>
                <dt class="sr-only">{s.label}</dt>
                <dd class="display-md tabular-nums" data-countup data-target={target} data-suffix={suffix}>
                  {s.value}
                </dd>
                <dd class="mt-0.5 text-[11px] font-medium uppercase tracking-widest text-ink-muted">{s.label}</dd>
              </div>
            );
          })
        }
      </dl>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    try {
      const els = document.querySelectorAll("[data-countup]");
      if (!els.length) return;
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const animate = (el) => {
        const target = Number(el.dataset.target || "0");
        const suffix = el.dataset.suffix || "";
        if (reduceMotion || !Number.isFinite(target)) {
          el.textContent = `${target}${suffix}`;
          return;
        }
        const duration = 1200;
        let start;
        const step = (t) => {
          if (start === undefined) start = t;
          const p = Math.min((t - start) / duration, 1);
          const eased = 1 - Math.pow(1 - p, 3);
          el.textContent = `${Math.round(target * eased)}${suffix}`;
          if (p < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      };
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              animate(entry.target);
              io.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.4 }
      );
      els.forEach((el) => {
        if (el.dataset.countupBound) return;
        el.dataset.countupBound = "true";
        io.observe(el);
      });
    } catch {}
  })();
</script>
