---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Icon from "../components/Icon.astro";
import { site } from "../data/site";

const CAL_LINK = site.calLink; // e.g. https://cal.com/mdomarali.com/15min
const CAL_PATH = CAL_LINK.replace(/^https?:\/\/cal\.com\//, "");
const WHATSAPP = site.whatsapp;
const EMAIL = site.email;
---

<Layout
  title="Book your free intro call | Md. Omar Ali"
  description="Book a free 15-minute intro call with Md. Omar Ali. Pick a time that suits you, no commitment. Prefer chat? WhatsApp or email instead."
  hideBookWidget
>
  <Nav />
  <main class="mx-auto max-w-6xl px-5 py-14">
    <div class="mx-auto max-w-2xl text-center">
      <p class="inline-flex items-center gap-1.5 rounded-full bg-surface-1 px-3.5 py-1.5 text-xs font-semibold text-ink">
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-success"></span>
        15-min · No commitment
      </p>
      <h1 class="display-lg mt-4">Book your free intro call.</h1>
      <p class="mt-4 text-lg leading-snug text-ink-muted">
        Pick a time that suits you. We will talk goal, scope, and whether I am the right fit.
      </p>
    </div>

    <div class="book-cal-wrap mx-auto mt-10 w-full min-w-0 max-w-4xl overflow-clip rounded-xxl border border-hairline-soft bg-canvas">
      <div id="book-cal" class="book-cal-empty min-w-0"></div>
    </div>

<style>
  .book-cal-wrap {
    /* Clip Cal's fixed-min-width month_view on small screens instead of
       letting a white/canvas gutter show on the right. */
    max-width: 100%;
    isolation: isolate;
  }
  #book-cal {
    width: 100%;
    max-width: 100%;
    min-width: 0;
  }
  #book-cal iframe {
    display: block;
    width: 100% !important;
    max-width: 100% !important;
    min-width: 0 !important;
    border: 0;
    margin: 0;
  }
  /* Loading placeholder only: removed automatically once Cal mounts its iframe. */
  #book-cal.book-cal-empty:empty {
    min-height: 560px;
    background:
      radial-gradient(circle at 50% 40%, var(--color-surface-2), transparent 70%),
      var(--color-canvas);
    animation: book-cal-pulse 1.6s ease-in-out infinite;
  }
  @keyframes book-cal-pulse {
    0%,
    100% {
      opacity: 0.55;
    }
    50% {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    #book-cal.book-cal-empty:empty {
      animation: none;
      opacity: 0.8;
    }
  }
</style>

    <div class="mx-auto mt-6 flex max-w-4xl flex-wrap items-center justify-center gap-3 text-sm">
      <span class="text-ink-muted">Embed not loading?</span>
      <a href={CAL_LINK} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 font-medium text-accent hover:underline">
        Open on cal.com <Icon name="arrow" class="h-4 w-4" />
      </a>
      <span aria-hidden="true" class="text-ink-muted">·</span>
      <a href={WHATSAPP} target="_blank" rel="noopener" class="font-medium text-accent hover:underline">WhatsApp</a>
      <span aria-hidden="true" class="text-ink-muted">·</span>
      <a href={`mailto:${EMAIL}`} class="font-medium text-accent hover:underline">Email</a>
    </div>
  </main>
  <Footer />
</Layout>

<script is:inline>
  (function (C, A, L) {
    let p = function (a, ar) { a.q.push(ar); };
    let d = C.document;
    C.Cal = C.Cal || function () {
      let cal = C.Cal;
      let ar = arguments;
      if (!cal.loaded) {
        cal.ns = {};
        cal.q = cal.q || [];
        d.head.appendChild(d.createElement("script")).src = A;
        cal.loaded = true;
      }
      if (ar[0] === L) {
        const api = function () { p(api, arguments); };
        const namespace = ar[1];
        api.q = api.q || [];
        if (typeof namespace === "string") {
          cal.ns[namespace] = cal.ns[namespace] || api;
          p(cal.ns[namespace], ar);
          p(cal, ["initNamespace", namespace]);
        } else p(cal, ar);
        return;
      }
      p(cal, ar);
    };
  })(window, "https://app.cal.com/embed/embed.js", "init");
</script>
<script define:vars={{ calPath: CAL_PATH }}>
  try {
    // Placeholder styles live on :empty, so they vanish the moment Cal
    // appends its iframe — no JS cleanup needed.
    Cal("init", { origin: "https://app.cal.com" });
    // Theme the booker to match the site so the Cal.com footer bar blends
    // in (cross-origin iframe, so we cannot query/hide nodes inside it).
    // Full removal needs Cal dashboard → Appearance → Disable branding (paid).
    Cal("ui", {
      theme: "auto",
      layout: "month_view",
      cssVarsPerTheme: {
        light: {
          "cal-bg": "#ffffff",
          "cal-bg-emphasis": "#f4f4f4",
          "cal-border-booker": "#e6e6e6",
          "cal-border-booker-width": "0px",
          radius: "30px",
        },
        dark: {
          "cal-bg": "#090909",
          "cal-bg-emphasis": "#141414",
          "cal-bg-subtle": "#141414",
          "cal-border-booker": "#1a1a1a",
          "cal-border-booker-width": "0px",
          radius: "30px",
        },
      },
    });
    Cal("inline", {
      elementOrSelector: "#book-cal",
      calLink: calPath,
      config: {
        layout: "month_view",
        theme: "auto",
        // Stack calendar → slots on phones instead of squeezing the
        // 3-column desktop grid (fixes the right-side gap on ~440px).
        useSlotsViewOnSmallScreen: "true",
      },
    });
  } catch (e) {
    /* Embed blocked (e.g. adblocker) — fallback links above cover booking. */
  }
</script>
