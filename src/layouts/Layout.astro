---
import "../styles/global.css";
import { site, defaultMeta } from "../data/site";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = defaultMeta.title,
  description = defaultMeta.description,
} = Astro.props;

const canonicalBase = site.url;
const canonical = Astro.url
  ? new URL(Astro.url.pathname, canonicalBase).toString()
  : canonicalBase;
const schema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.name,
  url: canonicalBase,
  nationality: "Bangladeshi",
  homeLocation: "Dhaka, Bangladesh",
  jobTitle: "Economics Student, Aspiring Data & Business Analyst",
  knowsAbout: ["Data Analysis", "Business Analysis", "Economics", "SEO", "Presentation Design", "Video Editing"],
  sameAs: ["https://www.linkedin.com/", "https://github.com/", "https://www.behance.net/"],
};
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      try {
        if (localStorage.theme === "light") document.documentElement.classList.remove("dark");
      } catch (e) {}
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <link rel="canonical" href={canonical} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-canvas text-ink antialiased">
    <slot />
    {/* Floating call widget, site-wide. TODO: real Cal.com event link */}
    <a
      href={site.calLink}
      target="_blank"
      rel="noopener"
      class="fixed bottom-5 right-5 z-40 flex items-center gap-3 rounded-full border border-hairline-soft bg-surface-1/90 py-2 pl-2 pr-5 shadow-xl backdrop-blur transition hover:bg-surface-2"
    >
      <span class="flex h-9 w-9 items-center justify-center rounded-full bg-ink text-canvas">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" class="h-4 w-4">
          <rect x="3" y="5" width="18" height="16" rx="2" /><path d="M8 3v4M16 3v4M3 10h18" />
        </svg>
      </span>
      <span class="leading-tight">
        <span class="block text-sm font-semibold">Book a Call</span>
        <span class="block text-xs text-ink-muted">No commitment</span>
      </span>
    </a>
    <script is:inline>
      // Dribbble-style hover previews: muted loop while hovered/focused,
      // static first frame otherwise. Skipped on touch and reduced-motion.
      (() => {
        try {
          if (!window.matchMedia("(hover: hover)").matches) return;
          if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
          document.querySelectorAll("video[data-hover-play]").forEach((v) => {
            const host = v.closest("a") || v;
            host.addEventListener("mouseenter", () => { v.play().catch(() => {}); });
            host.addEventListener("mouseleave", () => { v.pause(); try { v.currentTime = 0; } catch (e) {} });
            host.addEventListener("focusin", () => { v.play().catch(() => {}); });
            host.addEventListener("focusout", () => { v.pause(); try { v.currentTime = 0; } catch (e) {} });
          });
        } catch (e) {}
      })();
    </script>
  </body>
</html>
